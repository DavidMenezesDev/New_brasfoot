<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Brasfoot.App.ViewModels"
             x:Class="Brasfoot.App.Views.PlaceholderView"
             x:DataType="vm:PlaceholderViewModel">
  <Border Classes="card" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32">
    <StackPanel Spacing="8">
      <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
      <TextBlock Text="{Binding Description}" Classes="muted" HorizontalAlignment="Center" />
    </StackPanel>
  </Border>
</UserControl>
